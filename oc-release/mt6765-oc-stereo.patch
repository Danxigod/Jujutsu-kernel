+/* ===========================================================================
+ * OC STEREO: salida de audio dual (altavoz inferior + auricular superior)
+ *
+ * El codec MT6357 reparte el DAC de audio entre tres salidas analogas:
+ *   HPL/HPR -> jack de auriculares
+ *   HS      -> auricular ("handset"), el de la parte de arriba
+ *   LOL     -> altavoz ("line out"), el de la parte de abajo
+ *
+ * En este movil el altavoz es el LO interno (MTK_AUDIO_SPEAKER_PATH=int_lo_buf)
+ * y el auricular es el HS interno (RCV_PATH_INT=yes). El HAL de MIUI enciende
+ * esas salidas con los controles ALSA "Speaker_Amp_Switch" y "Voice_Amp_Switch",
+ * que es lo que interceptamos aqui: cuando el altavoz se enciende encendemos
+ * tambien el auricular, de modo que la musica sale por los dos extremos.
+ *
+ * El mux de entrada del HS (AUDHSMUXINPUTSEL), el del altavoz
+ * (AUDLOLMUXINPUTSEL) y sus ganancias son ajustables en caliente por
+ * /proc/oc_stereo: mux=0..3, lolmux=0..3, gain=0..18, lolgain=-1..18.
+ *
+ * La ganancia va de 0 (+8 dB, el maximo del PGA) a 17 (-10 dB) y 18 es el
+ * silencio; por defecto el auricular se deja en +8 dB para que se oiga fuerte.
+ * La del altavoz sigue al HAL (lolgain=-1) para que el volumen de la musica
+ * funcione igual de siempre.
+ *
+ * Para subir el auricular (y solo el auricular) hay dos mandos mas:
+ *   hsbias=N   corriente de bias del HS (campo HS de AUDDEC_ANA_CON10, 0..3;
+ *              de fabrica 1 = 5uA). Es lo unico que queda del amplificador
+ *              del auricular: el PGA ya va a +8 dB, que es su tope.
+ *   cmfb=0|1   realimentacion de modo comun del HS (bit 7 de AUDDEC_ANA_CON6).
+ *              El driver original solo la enciende en el camino de voz, asi
+ *              que en modo altavoz el auricular sale mas flojo.
+ *   bias=<campo> <valor>  campo 0=ZCD, 1=HP, 2=HS, 3=LO (para experimentar).
+ *   reg=<offset> <valor> [mascara]  escritura libre de un registro del codec
+ *              (offset relativo a AUD_PMIC_REG_BASE = 0x2080).
+ * ======================================================================== */
+#define OC_STEREO_PROC_NAME "oc_stereo"
+
+enum oc_stereo_hs_state {
+	OC_HS_OFF = 0,
+	OC_HS_BY_HAL,
+	OC_HS_BY_OC,
+};
+
+static int oc_stereo_master = 1;	/* salida dual activada */
+static int oc_stereo_mux = 2;		/* AUDHSMUXINPUTSEL del HS */
+static int oc_stereo_gain = DL_GAIN_8DB;	/* +8 dB: tope del PGA del HS */
+static int oc_stereo_lol_mux = 2;	/* AUDLOLMUXINPUTSEL del altavoz */
+static int oc_stereo_lol_gain = -1;	/* ganancia del altavoz (<0 = la del HAL) */
+static int oc_stereo_hs_state = OC_HS_OFF;
+static int oc_stereo_hs_cmfb = 1;	/* bit 7 de AUDDEC_ANA_CON6: CMFB del HS */
+static bool oc_stereo_spk_on;
+static bool oc_stereo_hal_hs_on;	/* el HAL quiere el auricular encendido */
+
+/* Escala del mixer del driver: 0 = +8 dB ... 17 = -10 dB y 18 = -40 dB, que es
+ * el valor de silencio (DL_GAIN_N_40DB). El ultimo paso valido del registro
+ * es el 20 (-12 dB), que el mixer del driver no usa. */
+#define OC_GAIN_MAX 18
+#define OC_GAIN_MUTE DL_GAIN_N_40DB
+#define OC_GAIN_REG_MAX 20
+
+static bool oc_stereo_gain_valid(unsigned int idx)
+{
+	return idx <= OC_GAIN_REG_MAX || idx == OC_GAIN_MUTE;
+}
+
+static unsigned int oc_stereo_gain_reg(int idx)
+{
+	if (idx < 0 || idx >= OC_GAIN_MAX)
+		return OC_GAIN_MUTE;
+	return (unsigned int)idx;
+}
+
+/* Rampa de ganancia del auricular: se cambia el registro de 5 bits paso a
+ * paso (solo por pasos validos) para que no chasquee. */
+static void oc_stereo_gain_ramp(unsigned int target)
+{
+	unsigned int cur = Ana_Get_Reg(ZCD_CON3) & 0x001f;
+	unsigned int i;
+
+	if (cur == target)
+		return;
+	if (target > cur) {
+		for (i = cur + 1; i <= target; i++)
+			if (oc_stereo_gain_valid(i))
+				Ana_Set_Reg(ZCD_CON3, i, 0x001f);
+	} else {
+		for (i = cur; i > target; i--)
+			if (oc_stereo_gain_valid(i))
+				Ana_Set_Reg(ZCD_CON3, i, 0x001f);
+	}
+	Ana_Set_Reg(ZCD_CON3, target, 0x001f);
+}
+
+/* El mux del altavoz (bits 3:2 de AUDDEC_ANA_CON4) decide que canal del DAC
+ * sale por el LO. Con 2 (el valor de fabrica) sale la mezcla L+R. */
+static void oc_stereo_lo_apply(void)
+{
+	if (!oc_stereo_spk_on)
+		return;
+	Ana_Set_Reg(AUDDEC_ANA_CON4, (oc_stereo_lol_mux & 0x3) << 2, 0x3 << 2);
+	if (oc_stereo_lol_gain >= 0)
+		apply_speaker_gain(oc_stereo_gain_reg(oc_stereo_lol_gain));
+	else
+		/* vuelve a la ganancia que fijo el HAL */
+		apply_speaker_gain(mCodec_data->mAudio_Ana_Volume
+				   [AUDIO_ANALOG_VOLUME_LINEOUTR]);
+}
+
+static void oc_stereo_hs_enable(void)
+{
+	unsigned int mux = (oc_stereo_mux & 0x3) << 2;
+
+	/* Liberar el pull-down del CMFB del auricular (bit 5). El del altavoz
+	 * (bit 7) ya lo libero Speaker_Amp_Change(). */
+	Ana_Set_Reg(AUDDEC_ANA_CON7, 0x0000, 0x0020);
+	/* El DAC de audio ya esta encendido por el altavoz: solo fijamos sus bits
+	 * (no tocamos los del mux de auriculares, bits 9 y 11) */
+	Ana_Set_Reg(AUDDEC_ANA_CON0, 0x3009, 0x3009);
+	/* El CMFB del auricular (bit 7 de AUDDEC_ANA_CON6) solo lo enciende el
+	 * camino de voz del driver: en modo altavoz se queda apagado y el
+	 * auricular sale flojo. El valor del vendor con el auricular activo es
+	 * 0x0281 = 0x0201 (altavoz) + este bit. */
+	Ana_Set_Reg(AUDDEC_ANA_CON6, oc_stereo_hs_cmfb ? 0x0080 : 0x0000,
+		    0x0080);
+	/* Corriente de bias del auricular (campo HS de AUDDEC_ANA_CON10) */
+	oc_bias_apply();
+	/* Sin proteccion de cortocircuito en el auricular */
+	Ana_Set_Reg(AUDDEC_ANA_CON3, 0x0010, 0x0010);
+	/* Auricular: STB enhance -> bias -> nucleo, con el mux de entrada */
+	Ana_Set_Reg(AUDDEC_ANA_CON3, 0x0090 | mux, 0xffff);
+	Ana_Set_Reg(AUDDEC_ANA_CON3, 0x0092 | mux, 0xffff);
+	Ana_Set_Reg(AUDDEC_ANA_CON3, 0x0093 | mux, 0xffff);
+	/* Ganancia con rampa para que no chasquee */
+	oc_stereo_gain_ramp(oc_stereo_gain_reg(oc_stereo_gain));
+	mCodec_data->mAudio_Ana_Volume[AUDIO_ANALOG_VOLUME_HSOUTL] =
+	    oc_stereo_gain_reg(oc_stereo_gain);
+	mCodec_data->mAudio_Ana_DevicePower
+	    [AUDIO_ANALOG_DEVICE_OUT_EARPIECEL] = true;
+	oc_stereo_hs_state = OC_HS_BY_OC;
+	oc_stereo_lo_apply();
+	pr_info("%s(): HS on mux=%d gain=%d lol_mux=%d ANA_CON0=0x%04x ANA_CON3=0x%04x ANA_CON4=0x%04x ANA_CON7=0x%04x\n",
+		__func__, oc_stereo_mux, oc_stereo_gain, oc_stereo_lol_mux,
+		Ana_Get_Reg(AUDDEC_ANA_CON0), Ana_Get_Reg(AUDDEC_ANA_CON3),
+		Ana_Get_Reg(AUDDEC_ANA_CON4), Ana_Get_Reg(AUDDEC_ANA_CON7));
+}
+
+static void oc_stereo_hs_mute(void)
+{
+	/* Apagado minimo: silenciamos y desconectamos el HS sin tocar el DAC
+	 * ni el amplificador del altavoz. */
+	Ana_Set_Reg(ZCD_CON3, DL_GAIN_N_40DB, 0x001f);
+	Ana_Set_Reg(AUDDEC_ANA_CON3, 0x0000, 0x008f);
+	Ana_Set_Reg(AUDDEC_ANA_CON7, 0x0020, 0x0020);
+	mCodec_data->mAudio_Ana_DevicePower
+	    [AUDIO_ANALOG_DEVICE_OUT_EARPIECEL] = false;
+	oc_stereo_hs_state = OC_HS_OFF;
+	pr_info("%s(): HS off\n", __func__);
+}
+
+static int oc_stereo_proc_show(struct seq_file *m, void *v)
+{
+	seq_printf(m,
+		   "master=%d mux=%d gain=%d lol_mux=%d lol_gain=%d state=%d spk_on=%d hal_hs=%d\n",
+		   oc_stereo_master, oc_stereo_mux, oc_stereo_gain,
+		   oc_stereo_lol_mux, oc_stereo_lol_gain, oc_stereo_hs_state,
+		   oc_stereo_spk_on, oc_stereo_hal_hs_on);
+	seq_printf(m,
+		   "ANA_CON0=0x%04x ANA_CON3=0x%04x ANA_CON4=0x%04x ANA_CON7=0x%04x\n",
+		   Ana_Get_Reg(AUDDEC_ANA_CON0), Ana_Get_Reg(AUDDEC_ANA_CON3),
+		   Ana_Get_Reg(AUDDEC_ANA_CON4), Ana_Get_Reg(AUDDEC_ANA_CON7));
+	seq_printf(m, "ZCD_CON1=0x%04x ZCD_CON3=0x%04x\n",
+		   Ana_Get_Reg(ZCD_CON1), Ana_Get_Reg(ZCD_CON3));
+	seq_printf(m,
+		   "ANA_CON6=0x%04x ANA_CON10=0x%04x bias_reg=0x%04x cmfb=%d\n",
+		   Ana_Get_Reg(AUDDEC_ANA_CON6), Ana_Get_Reg(AUDDEC_ANA_CON10),
+		   oc_bias_reg, oc_stereo_hs_cmfb);
+	return 0;
+}
+
+static int oc_stereo_proc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, oc_stereo_proc_show, NULL);
+}
+
+static ssize_t oc_stereo_proc_write(struct file *file, const char __user *buf,
+				    size_t count, loff_t *ppos)
+{
+	char cmd[64];
+	int val;
+	int val2;
+	unsigned int off;
+	unsigned int uval;
+	unsigned int umask = 0xffff;
+	size_t len = min(count, sizeof(cmd) - 1);
+
+	if (copy_from_user(cmd, buf, len))
+		return -EFAULT;
+	cmd[len] = '\0';
+
+	if (!strncmp(cmd, "on", 2)) {
+		oc_stereo_master = 1;
+	} else if (!strncmp(cmd, "off", 3)) {
+		oc_stereo_master = 0;
+	} else if (!strncmp(cmd, "force", 5)) {
+		/* enciende el auricular ahora mismo, sin esperar al altavoz */
+		oc_stereo_master = 1;
+		oc_stereo_hs_enable();
+		return count;
+	} else if (sscanf(cmd, "mux=%d", &val) == 1) {
+		if (val < 0 || val > 3)
+			return -EINVAL;
+		oc_stereo_mux = val;
+	} else if (sscanf(cmd, "gain=%d", &val) == 1) {
+		if (val < 0 || val > OC_GAIN_MAX)
+			return -EINVAL;
+		oc_stereo_gain = val;
+	} else if (sscanf(cmd, "lolmux=%d", &val) == 1) {
+		if (val < 0 || val > 3)
+			return -EINVAL;
+		oc_stereo_lol_mux = val;
+	} else if (sscanf(cmd, "lolgain=%d", &val) == 1) {
+		if (val < -1 || val > OC_GAIN_MAX)
+			return -EINVAL;
+		oc_stereo_lol_gain = val;
+	} else if (sscanf(cmd, "hsbias=%d", &val) == 1) {
+		/* corriente de bias del auricular: campo HS (bits 5:4) de
+		 * AUDDEC_ANA_CON10. De fabrica es 1 (5uA) */
+		if (val < 0 || val > 3)
+			return -EINVAL;
+		oc_bias_reg &= ~(0x3u << OC_BIAS_HS_SHIFT);
+		oc_bias_reg |= ((unsigned int)val & 0x3) << OC_BIAS_HS_SHIFT;
+		oc_bias_apply();
+	} else if (sscanf(cmd, "bias=%d %d", &val, &val2) == 2) {
+		/* campo 0=ZCD [1:0], 1=HP [3:2], 2=HS [5:4], 3=LO [7:6] */
+		if (val < 0 || val > 3 || val2 < 0 || val2 > 3)
+			return -EINVAL;
+		oc_bias_reg &= ~(0x3u << (val * 2));
+		oc_bias_reg |= ((unsigned int)val2 & 0x3) << (val * 2);
+		oc_bias_apply();
+	} else if (sscanf(cmd, "cmfb=%d", &val) == 1) {
+		/* bit 7 de AUDDEC_ANA_CON6: la realimentacion de modo comun del HS */
+		if (val < 0 || val > 1)
+			return -EINVAL;
+		oc_stereo_hs_cmfb = val;
+	} else if (sscanf(cmd, "reg=%x %x %x", &off, &uval, &umask) >= 2) {
+		/* escritura libre de un registro del codec: el offset es relativo a
+		 * AUD_PMIC_REG_BASE (0x2080), p.ej. 0x19c = AUDDEC_ANA_CON10 */
+		Ana_Set_Reg(AUD_PMIC_REG_BASE + off, uval, umask);
+	} else {
+		return -EINVAL;
+	}
+
+	if (oc_stereo_spk_on)
+		oc_stereo_lo_apply();
+	if (oc_stereo_master && oc_stereo_spk_on) {
+		oc_stereo_hs_enable();
+	} else if (oc_stereo_hs_state == OC_HS_BY_OC && !oc_stereo_hal_hs_on) {
+		oc_stereo_hs_mute();
+	}
+
+	pr_info("%s(): '%s' master=%d mux=%d gain=%d lol_mux=%d lol_gain=%d bias=0x%04x cmfb=%d\n",
+	       __func__, cmd, oc_stereo_master, oc_stereo_mux, oc_stereo_gain,
+	       oc_stereo_lol_mux, oc_stereo_lol_gain, oc_bias_reg,
+	       oc_stereo_hs_cmfb);
+	return count;
+}
